{
  "name": "@synadia-ai/agent-fabric-pi",
  "version": "0.1.0",
  "description": "The Synadia Agent Fabric add-on for the PI channel plugin: the fabric's tracing on PI's service, its client and its own model calls, the loop guard, and ScratchPad's skill with the sp command line, as one extension module the plugin loads.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "build:sp": "sh ../scratchpad-skill/install.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepack": "npm run build:sp",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nats",
    "ai",
    "agents",
    "agent-fabric",
    "tracing",
    "pi",
    "synadia",
    "sdk"
  ],
  "license": "Apache-2.0",
  "author": "Synadia Communications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synadia-ai/agent-fabric-sdk.git",
    "directory": "plugins/pi"
  },
  "homepage": "https://github.com/synadia-ai/agent-fabric-sdk/tree/main/plugins/pi",
  "bugs": {
    "url": "https://github.com/synadia-ai/agent-fabric-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@synadia-ai/agent-fabric": "file:../../typescript",
    "@synadia-ai/agent-service": "file:../../../synadia-agents/agent-sdk/typescript",
    "@synadia-ai/agents": "file:../../../synadia-agents/client-sdk/typescript"
  },
  "devDependencies": {
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@types/node": "^20.16.0",
    "ajv": "^8.17.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "3.9.5",
    "tsup": "^8.3.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitest": "^3.2.0"
  }
}
