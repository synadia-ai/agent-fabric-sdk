# One agent, one file. Copy to .env next to pyproject.toml (gitignored) and
# start with `uv run python -m fabric_agent`. The same variables as the
# TypeScript agent's env.example.
# Every variable the agent reads is here, with what it is and where your fabric
# gives it to you. Nothing in the copy belongs in a repository: the credentials
# path names a file issued for this agent, and the virtual key is a secret.
# The caller (`python -m fabric_agent.prompt <env file> …`) reads the NATS lines
# of the file it is given.

# --- the fabric: where to connect and as whom -----------------------------
# The URL of your fabric's NATS, and the user credentials file the console's
# onboarding issued for this agent. One user per agent, never shared: the same
# file signs the agent's identity, and ScratchPad's CLI connects with it too.
NATS_URL=nats://127.0.0.1:4222
NATS_CREDS=/path/to/this-agent.creds
# Or, in place of the two lines above, a NATS context by name (`nats context add`).
#NATS_CONTEXT=my-agent
# An nkey seed file works for the connection too, but ScratchPad's CLI needs creds or a context.
#NATS_NKEY_SEED_FILE=/path/to/this-agent.nk

# --- who this agent is -------------------------------------------------------
# The three names make the agent's address, agents.prompt.<kind>.<owner>.<name>,
# which is what other agents see in discovery and prompt. Yours to choose.
AGENT_KIND=assistant              # the kind of agent: assistant, researcher, writer, …
AGENT_OWNER=me                    # who runs it; defaults to $USER
AGENT_NAME=main                   # the instance; several agents of one kind and owner differ here
#AGENT_DESCRIPTION=Answers questions and delegates when another agent fits better   # what discovery shows other agents; default "<kind> agent (<model>)"
#AGENT_SYSTEM_PROMPT=You are a helpful agent on the Synadia Agent Fabric. …          # the persona; a plain default when unset
#AGENT_SYSTEM_PROMPT_FILE=./persona.md   # a longer persona from a file; wins over the line above
AGENT_MIN_SENDER_TRUST=any        # any, or signed: refuse a prompt whose sender's signature does not verify
#AGENT_TOOLS=blocking             # the agent tools the model is offered: blocking (discover_agents, prompt_agent, answer_agent), all (the six), none
#AGENT_REPLY_TIMEOUT_MS=300000    # how long one prompt to another agent may run before it is given up; it includes that agent's own model calls
#AGENT_HEARTBEAT_S=30             # how often the agent says it is alive; the console shows it online from this
#AGENT_MAX_HISTORY=20             # user/assistant exchanges remembered
#AGENT_READY_FILE=/path/to/ready.json   # when set, one JSON line about the running agent is written here once it serves

# --- the model, behind the proxy ---------------------------------------------
# The URL of your fabric's model proxy, with the path your provider needs in
# front of /v1/chat/completions: /api for OpenRouter (the proxy forwards to
# https://openrouter.ai/api/v1/…); nothing for a provider whose origin is the
# /v1 root, such as a local Ollama at http://localhost:11434.
MODEL_PROXY_URL=http://127.0.0.1:18181/api
# The virtual key issued for this agent's identity in the console's key
# manager. It names the provider behind the proxy; the agent never sees the
# provider's own key.
MODEL_VIRTUAL_KEY=sk_syn_…
# A model that provider serves, and one that calls tools properly: a small
# model invents addresses and tool results.
MODEL_NAME=anthropic/claude-sonnet-5
#MODEL_TIMEOUT_MS=120000          # how long one model call may take

# --- ScratchPad, optional: the fabric package's four variables -----------------
# The agent writes no ScratchPad code: the fabric package builds its ScratchPad
# from these and drives `sp`, ScratchPad's command line, which connects with
# the NATS lines above. SCRATCHPAD_VOLUME is the switch: unset, the agent hands
# work over as text; set, by reference. `sp` needs NATS_URL with NATS_CREDS: it
# reads no NATS context. The volume, letters and digits only, is provisioned by
# your deployment for this agent's account and user, and created on first use.
#SCRATCHPAD_VOLUME=AssistantReplies
#SCRATCHPAD_BIN=sp                # the `sp` binary; default `sp` on PATH
#SCRATCHPAD_DIR=/path/to/a/dir    # private directory for the CLI's workspace, kept across restarts; default scratchpad-<volume> under the temp directory
#SCRATCHPAD_GRANT_TTL_S=600       # how long another agent may read a reference this agent hands it; default 600: one agent, one path, read only, then it lapses

# --- the caller only (python -m fabric_agent.prompt) ---------------------------
#PROMPT_TIMEOUT_MS=600000         # how long the caller waits for the whole reply
