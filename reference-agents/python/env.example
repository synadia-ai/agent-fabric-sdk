# One agent, one file. Copy to .env next to pyproject.toml (gitignored) and
# start with `uv run python -m fabric_agent`. The same variables as the
# TypeScript agent's env.example.
# Every variable the agent reads is here, with what it is and where your fabric
# gives it to you. Nothing in the copy belongs in a repository: the credentials
# path names a file issued for this agent, and the virtual key is a secret.
# The caller (`python -m fabric_agent.prompt <env file> …`) reads the NATS lines
# of the file it is given.

# --- the fabric: where to connect and as whom -----------------------------
# The URL of your fabric's NATS, and the user credentials file the console's
# onboarding issued for this agent. One user per agent, never shared: the same
# file signs the agent's identity. ScratchPad borrows that authenticated connection.
NATS_URL=nats://127.0.0.1:4222
NATS_CREDS=/path/to/this-agent.creds
# Or, in place of the two lines above, a NATS context by name (`nats context add`).
#NATS_CONTEXT=my-agent
# An nkey seed file works for the connection too, when the account is provisioned for it.
#NATS_NKEY_SEED_FILE=/path/to/this-agent.nk

# --- who this agent is -------------------------------------------------------
# The three names make the agent's address, agents.prompt.<kind>.<owner>.<name>,
# which is what other agents see in discovery and prompt. Yours to choose.
AGENT_KIND=assistant              # the kind of agent: assistant, researcher, writer, …
AGENT_OWNER=me                    # who runs it; defaults to $USER
AGENT_NAME=main                   # the instance; several agents of one kind and owner differ here
# What this agent does, what to ask it, what it can reach or never does: one
# to three sentences in the third person, on one line of plain text of at
# most 500 characters (the agent turns a line break into a space and cuts a
# longer text). The other agents of the account read it in discovery when
# they choose whom to ask, and the account's people read it in the console:
# nothing signs it, and it is no place for a secret. `fabric connect
# --description` (fabric 0.19.0 or later) and the Description field of the
# console's Connect form supply it, and what they set wins over this line.
# Restart the agent to apply a change. Put a text that holds a # in double
# quotes. Default: "<kind> agent (<model>)".
#AGENT_DESCRIPTION=Keeps the logs of the orders server. Ask it what happened in a time range. Reads only; changes nothing on the server.
#AGENT_SYSTEM_PROMPT=You are a helpful agent on the Synadia Agent Fabric. …          # the persona; a plain default when unset
#AGENT_SYSTEM_PROMPT_FILE=./persona.md   # a longer persona from a file; wins over the line above
AGENT_MIN_SENDER_TRUST=signed     # signed, or any: signed refuses an unsigned prompt; any, the default when unset, serves it too. `fabric env` (fabric 0.18.0 or later) sets it
#AGENT_TOOLS=blocking             # the agent tools the model is offered: blocking (discover_agents, prompt_agent, answer_agent), all (the six), none
#AGENT_REPLY_TIMEOUT_MS=300000    # how long one prompt to another agent may run before it is given up; it includes that agent's own model calls
#AGENT_HEARTBEAT_S=30             # how often the agent says it is alive; the console shows it online from this
#AGENT_MAX_HISTORY=20             # user/assistant exchanges remembered per verified caller; 0 for none (every prompt stands alone)
#AGENT_READY_FILE=/path/to/ready.json   # when set, one JSON line about the running agent is written here once it serves
#AGENT_DURABLE=0                 # 1: host durable workflows (the demo durable-task) and offer the model start_workflow; the connection must reach a durable engine on de.api.v1.* (on the fabric, the tenant's import, made by the console's onboarding)

# --- the model, behind the proxy ---------------------------------------------
# The provider the virtual key below names, as the console and `fabric env`
# call it: openrouter, openai or anthropic. With anthropic the agent speaks
# Anthropic's own Messages API (/v1/messages), the only one on which the proxy
# records an Anthropic call's tokens and content; with any other value, or
# none, the OpenAI chat-completions API (/v1/chat/completions).
#MODEL_PROVIDER=openrouter
# The URL of your fabric's model proxy, with the path your provider needs in
# front of /v1/…: /api for OpenRouter (the proxy forwards to
# https://openrouter.ai/api/v1/…); nothing for Anthropic, OpenAI, or a
# provider whose origin is the /v1 root, such as a local Ollama at
# http://localhost:11434.
MODEL_PROXY_URL=http://127.0.0.1:18181/api
# The virtual key issued for this agent's identity in the console's key
# manager. It names the provider behind the proxy; the agent never sees the
# provider's own key.
MODEL_VIRTUAL_KEY=sk_syn_…
# A model that provider serves, and one that calls tools properly: a small
# model invents addresses and tool results.
MODEL_NAME=anthropic/claude-sonnet-5
#MODEL_TIMEOUT_MS=120000          # how long one model call may take; a durable run's work between two waits must end within the engine's max work (5 minutes by default), or the step in flight runs again
#MODEL_MAX_TOKENS=16000           # anthropic only: the most tokens one reply may take, thinking included (Anthropic's max_tokens); a long reply also needs a longer MODEL_TIMEOUT_MS: 2 minutes fit about 8000 tokens

# --- ScratchPad, optional: the native client's three variables -----------------
# The agent writes no ScratchPad code: the fabric package builds its ScratchPad
# from these on the agent's existing NATS connection. SCRATCHPAD_VOLUME, or
# SCRATCHPAD_BOOTSTRAP_FILE (what `fabric env` sets for a reusable volume), is
# the switch: neither set, the agent hands work over as text; either, by reference.
# The volume, letters and digits only, is provisioned by
# your deployment for this agent's account and user, and created on first use.
#SCRATCHPAD_VOLUME=AssistantReplies
#SCRATCHPAD_DIR=/path/to/a/dir    # required persistent private directory (0700); one writer owns it
#SCRATCHPAD_GRANT_TTL_S=600       # how long another agent may read a reference this agent hands it; default 600: one agent, one path, read only, then it lapses

# --- the caller only (python -m fabric_agent.prompt) ---------------------------
#PROMPT_TIMEOUT_MS=600000         # how long the caller waits for the whole reply
