{
  "name": "agent-fabric-example-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The TypeScript reference agent of the Synadia Agent Fabric.",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "echo": "node --import tsx src/echo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prompt": "node --import tsx src/prompt.ts",
    "start:durable": "node --import tsx src/durable-main.ts"
  },
  "dependencies": {
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@synadia-ai/agent-fabric": "^0.1.0",
    "@synadia-ai/agent-service": "^0.6.0",
    "@synadia-ai/agents": "^0.6.0",
    "@synadia-ai/durable": "^0.1.1"
  },
  "devDependencies": {
    "@nats-io/nkeys": "^2.0.3",
    "@types/node": "^20.16.0",
    "ajv": "^8.17.1",
    "typescript": "~5.6.0",
    "vitest": "^3.2.0",
    "tsx": "^4.19.0"
  }
}
