{
  "name": "@synadia-ai/agent-fabric",
  "version": "0.1.0",
  "description": "The SDK for agents on the Synadia Agent Fabric — tracing and the agent tools' ScratchPad extension, on the hooks of the Synadia Agent Protocol SDK.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:native": "node scripts/run-native-tests.mjs",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nats",
    "ai",
    "agents",
    "agent-fabric",
    "tracing",
    "scratchpad",
    "synadia",
    "sdk"
  ],
  "license": "Apache-2.0",
  "author": "Synadia Communications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synadia-ai/agent-fabric-sdk.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/synadia-ai/agent-fabric-sdk/tree/main/typescript",
  "bugs": {
    "url": "https://github.com/synadia-ai/agent-fabric-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nats-io/nats-core": "^3.4.0",
    "@unicode/unicode-15.0.0": "2.0.7",
    "@synadia-ai/agent-service": "file:../../synadia-agents/agent-sdk/typescript",
    "@synadia-ai/agents": "file:../../synadia-agents/client-sdk/typescript"
  },
  "devDependencies": {
    "@nats-io/transport-node": "^3.4.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "3.9.5",
    "tsup": "^8.3.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitest": "^3.2.0"
  }
}
