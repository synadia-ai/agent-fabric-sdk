{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScratchPad bootstrap descriptor version 1",
  "description": "Request data only. Consumers also verify NKEY checksums, counter precision and the authenticated owner. The UTF-8 document ceiling is 4096 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "principal", "volume", "admission", "creation"],
  "properties": {
    "version": {"const": 1},
    "principal": {
      "type": "object", "additionalProperties": false,
      "required": ["account", "user"],
      "properties": {
        "account": {"type": "string", "pattern": "^A[A-Z2-7]{55}$"},
        "user": {"type": "string", "pattern": "^U[A-Z2-7]{55}$"}
      }
    },
    "volume": {"type": "string", "pattern": "^[0-9A-Za-z]{1,64}$"},
    "admission": {
      "type": "object", "additionalProperties": false,
      "required": ["slot", "generation", "operation_id"],
      "properties": {
        "slot": {"type": "integer", "minimum": 0, "maximum": 255},
        "generation": {"type": "integer", "minimum": 1, "description": "Unsigned 64-bit on the service. Native SDK consumers additionally refuse values above 9007199254740991."},
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "creation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "trace"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "trace": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "thread_id": {"type": "string", "pattern": "^(|[0-9a-f]{32})$"},
            "root_id": {"type": "string", "pattern": "^(|[0-9a-f]{32})$"},
            "tool_call_id": {"type": "string", "maxLength": 256}
          },
          "allOf": [{
            "if": {"anyOf": [
              {"required": ["thread_id"], "properties": {"thread_id": {"minLength": 1}}},
              {"required": ["root_id"], "properties": {"root_id": {"minLength": 1}}},
              {"required": ["tool_call_id"], "properties": {"tool_call_id": {"minLength": 1}}}
            ]},
            "then": {"required": ["thread_id", "root_id"], "properties": {
              "thread_id": {"pattern": "^[0-9a-f]{32}$"}, "root_id": {"pattern": "^[0-9a-f]{32}$"}
            }}
          }]
        }
      }
    }
  }
}
